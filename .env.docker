APP_NAME="Laravel Azure Tutorial"
APP_ENV=production
APP_KEY=base64:pa8M5gbH0ldK+5aQPIOwVpqxNLp7+mY2LSVp37d+eRA=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (MySQL service in Docker network)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=azure_tutorial
DB_USERNAME=laravel
DB_PASSWORD=secret

# Redis (Redis service in Docker network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail (Mailpit in Docker network)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Container Initialization
RUN_MIGRATIONS=true
RUN_QUEUE_WORKER=false
